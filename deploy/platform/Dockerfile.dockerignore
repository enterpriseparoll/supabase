# Newer Docker Compose (Bake) reads the Dockerfile through this filter too.
!deploy/platform/Dockerfile
!deploy/platform/Dockerfile.dockerignore
!apps/
!apps/control-plane/
!apps/control-plane/**
!docker/
!docker/**
**/node_modules
**/.env
**/.env.*
!docker/.env.example
**/volumes/db/data
**/volumes/storage
**/backups
